# The .env file contains secrets, for local development copy this file to .env and fill in details
# Keep this template updated whenever you have changed environment variable names

# Never commit actual values in this file

# Running the full stack with the API's Aspire AppHost
# ---------------------------------------------------
# `dotnet run --project src/Eventuras.AppHost` (from apps/api) starts PostgreSQL,
# the API, Keycloak, Mailpit and this app together, and injects APPLICATION_URL,
# BACKEND_URL, OIDC_ISSUER and NODE_EXTRA_CA_CERTS itself — process environment
# wins over .env, so the values below are only used when you run `pnpm dev`
# directly. The remaining values are the ones the AppHost cannot supply: they
# have to match src/Eventuras.AppHost/realms/eventuras-dev-realm.json.
#
#   OIDC_CLIENT_ID=web
#   OIDC_CLIENT_SECRET=dev-web-secret
#   OIDC_ISSUER=https://id.dev.localhost/realms/eventuras-dev
#   BACKEND_URL=https://api.dev.localhost
#
# Log in as admin@example.com; the one-time code arrives in Mailpit at
# https://mail.dev.localhost. Running `pnpm dev` by hand against that stack also needs
# NODE_EXTRA_CA_CERTS=<repo>/apps/api/src/Eventuras.AppHost/.certs/kc.pem, because
# Node does not read the OS trust store and Keycloak serves TLS.

# Application URL (e.g. https://web.dev.localhost)
APPLICATION_URL=

# API (server-side backend URL)
BACKEND_URL=

# OIDC Provider Configuration

# Redirect url after logging out (must be registered with your OIDC provider)
LOGOUT_URL_REDIRECT=

# OIDC Issuer URL
# Auth0: https://your-tenant.eu.auth0.com
# Authentik: https://auth.example.com/application/o/your-app/
# Local Aspire stack: https://id.dev.localhost/realms/eventuras-dev
OIDC_ISSUER=

# OIDC Client Id
OIDC_CLIENT_ID=

# OIDC Client Secret
OIDC_CLIENT_SECRET=

# OIDC API Audience (optional, for API token validation)
OIDC_API_AUDIENCE=

# Name of the ID token claim containing user roles (default: roles)
# Auth0: http://schemas.microsoft.com/ws/2008/06/identity/claims/role
# Authentik: roles
OIDC_ROLES_CLAIM=roles

# Session secret (must be a strong random string)
SESSION_SECRET=

# Eventuras Configuration

# Organization Id (to show events of, defaults to 1)
ORGANIZATION_ID=

# Debug (enable logs https://github.com/debug-js/debug) - example: eventuras:*,*api*
DEBUG=

# Default locale (en-US or nb-NO)
DEFAULT_LOCALE=

# Log level (debug, info, warn, error)
LOG_LEVEL=
